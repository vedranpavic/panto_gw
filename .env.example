# Kopieer dit bestand naar .env en vul je eigen waarden in.
# .env staat in .gitignore en wordt nooit gecommit.

# Jira Cloud basis-URL, bv. https://jouw-domein.atlassian.net
JIRA_BASE_URL=

# Atlassian-account e-mailadres waarmee het API-token is aangemaakt
JIRA_EMAIL=

# API-token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# JQL die de Epics selecteert die op het dashboard moeten verschijnen
JIRA_EPIC_JQL=issuetype = Epic ORDER BY created DESC

# Issue type-namen zoals ingericht in jullie Jira
JIRA_OBJECTIVE_ISSUE_TYPE=Objective
JIRA_FEATURE_ISSUE_TYPE=Feature

# Naam van de issue-link die Epic -> Objective -> Feature verbindt
# (het "Implements" / "Implemented by" linkpaar)
JIRA_HIERARCHY_LINK_TYPE=Implements

# Veld waarmee Stories aan een Feature hangen. Standaard het moderne
# "parent" veld; zet dit op "Epic Link" als jullie Stories nog het
# klassieke epic-link veld gebruiken.
JIRA_STORY_PARENT_FIELD=parent

# Custom field-ID's — opvraagbaar via
# https://<jouw-domein>.atlassian.net/rest/api/3/field
JIRA_FIELD_BUSINESS_VALUE=customfield_XXXXX
JIRA_FIELD_TEAM=customfield_XXXXX

# Komma-gescheiden status-namen die als "Needs Attention" moeten tonen,
# los van de Jira status-categorie
JIRA_ATTENTION_STATUSES=Blocked,At Risk,Impediment

# Hoe lang (ms) de opgehaalde hiërarchie in het geheugen wordt gecachet
CACHE_TTL_MS=120000

# Poort waarop de lokale API-bridge draait
API_PORT=8787
